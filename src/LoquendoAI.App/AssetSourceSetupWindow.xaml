<Window x:Class="LoquendoAI.App.AssetSourceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar fuente de assets" Height="720" Width="1180"
        MinHeight="580" MinWidth="900" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.Text}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Fuente de assets" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                       Text="Clasifica carpetas, no archivos uno por uno. Las reglas pueden heredarse a todas las subcarpetas y puedes agregar excepciones específicas."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Nombre"/>
                <TextBox Grid.Column="1" x:Name="SourceNameBox" Margin="8,0,20,8" Height="30"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Regla raíz"/>
                <ComboBox Grid.Column="3" x:Name="RootClassificationBox" Margin="8,0,0,8" Height="30"
                          ItemsSource="{Binding ClassificationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"/>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Carpeta"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="RootPathText"
                           Margin="8,0,0,8" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Metadata raíz"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" Text="Personaje / sujeto"/>
                        <TextBox x:Name="RootSubjectBox" Width="210" Height="30"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" Text="Colección / pack"/>
                        <TextBox x:Name="RootCollectionBox" Width="210" Height="30"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" Text="Fondo del render"/>
                        <ComboBox x:Name="RootCutoutBox" Width="190" Height="30"
                                  ItemsSource="{Binding CutoutOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="Reglas de carpeta" FontSize="16"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="BulkClassificationBox" Width="180" Height="30" Margin="6,0"
                              ItemsSource="{Binding ClassificationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                    <ComboBox x:Name="FolderNameRoleBox" Width="210" Height="30" Margin="8,0"
                              ItemsSource="{Binding FolderNameRoleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                    <Button Margin="6,0" Padding="12,5" Content="Aplicar a seleccionadas" Click="ApplyBulk_Click"/>
                    <Button Margin="6,0" Padding="12,5" Content="No clasificadas → Renders" Click="AutoRowsToRenders_Click"/>
                    <Button Margin="6,0,0,0" Padding="12,5" Content="Agregar regla específica…" Click="AddSpecificRule_Click"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" x:Name="RulesGrid" ItemsSource="{Binding Rules}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Carpeta" Binding="{Binding RelativeFolder}" Width="2*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Tipo" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ClassificationOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Classification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Personaje / sujeto (opcional)" Binding="{Binding SubjectName, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                    <DataGridTextColumn Header="Colección / pack (opcional)" Binding="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                    <DataGridCheckBoxColumn Header="Heredar" Binding="{Binding IncludeSubfolders}" Width="80"/>
                    <DataGridTemplateColumn Header="Fondo del render" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.CutoutOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding DefaultCutoutStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                       Text="Nota: no se exige separar expresiones. Si una carpeta es 'HOMERO' y contiene 200 imágenes sueltas, las 200 pueden ser renders de Homero sin más metadata. 'Fondo del render' solo prepara el estado para el futuro recortador automático; no modifica ningún archivo."/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}"
                       Text="Los archivos permanecen donde están; Loquendo AI solo guarda referencias y metadata."/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="100" Margin="6,0" Padding="12,6" Content="Cancelar" IsCancel="True"/>
                <Button Width="150" Margin="6,0,0,0" Padding="12,6" Content="Guardar fuente" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
