                                        ToolTip="Pulsa o arrastra en cualquier punto para ir a ese momento del video"
                                        PreviewMouseLeftButtonDown="SceneSeekSlider_MouseDown" PreviewMouseMove="SceneSeekSlider_MouseMove"
                                        PreviewMouseLeftButtonUp="SceneSeekSlider_MouseUp" LostMouseCapture="SceneSeekSlider_LostMouseCapture"
                                        ValueChanged="SceneSeekSlider_ValueChanged"/>
