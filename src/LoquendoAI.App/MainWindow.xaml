<Window x:Class="LoquendoAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loquendo AI" Height="900" Width="1360"
        MinHeight="640" MinWidth="1100"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.Text}"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded" Closing="MainWindow_Closing" Icon="Assets/loquendo-ai.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera roja: marca, proyecto y tema. -->
        <Border Background="{DynamicResource Theme.HeaderBar}" Padding="16,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Theme.HeaderBarText}">
                        <TextBlock Text="L" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Theme.HeaderBar}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Loquendo AI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Theme.HeaderBarText}"/>
                        <TextBlock x:Name="AppVersionText" Text="v" FontSize="11" Foreground="{DynamicResource Theme.HeaderBarMuted}"/>
                    </StackPanel>
                </StackPanel>
                <ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="120" Height="30" Margin="14,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="ThemeCombo_SelectionChanged" ToolTip="Tema de la interfaz: el de Windows, claro u oscuro">
                    <ComboBoxItem Content="◐ Sistema" Tag="sistema"/>
                    <ComboBoxItem Content="☀ Claro" Tag="claro"/>
                    <ComboBoxItem Content="☾ Oscuro" Tag="oscuro"/>
                </ComboBox>
                <StackPanel x:Name="ProjectActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="ProjectNameBox" Width="170" Height="30" Margin="0,0,6,0" VerticalContentAlignment="Center" Text="Mi serie Loquendo"/>
                    <Button Margin="0,0,6,0" Padding="14,5" Content="Crear proyecto" Style="{StaticResource HeaderButton}" Click="CreateProject_Click"/>
                    <Button Margin="0,0,6,0" Padding="14,5" Content="Abrir proyecto" Style="{StaticResource HeaderButton}" Click="OpenProject_Click"/>
                    <Button Margin="6,0,6,0" Padding="10,5" Content="Copia de seguridad" Style="{StaticResource HeaderButton}" Click="BackupProject_Click"
                            ToolTip="Copia project.db en la carpeta backups del proyecto. Además se hace una copia automática al día al abrir el proyecto y otra antes de actualizar la base de datos (se guardan las 10 últimas de cada tipo)."/>
                    <Button Padding="10,5" Content="Limpiar caché…" Style="{StaticResource HeaderButton}" Click="CleanProjectCache_Click"
                            ToolTip="Muestra y borra previews antiguas, voces TTS que ya no usa ningún bloque, caché de voces sin uso de más de 30 días y temporales. Todo es regenerable; nunca toca recursos, voces grabadas, exportaciones ni copias."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Estado del proyecto. -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" FontWeight="SemiBold" Text="Todavía no hay un proyecto abierto."/>
                <TextBlock x:Name="ProjectPathText" DockPanel.Dock="Right" Margin="16,0,0,0" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Background="{DynamicResource Theme.WindowBackground}">
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Margin="0,0,6,0"/><TextBlock Text="Inicio"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Bienvenido a Loquendo AI"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                                   Text="Videos estilo Loquendo: voces, renders, fondos, cámara, gestos y barras de cine, con un Director IA y salida a VEGAS editable."/>
                        <UniformGrid Columns="3" Margin="0,22,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="1 · Proyecto" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Theme.Accent}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" Text="Crea o abre un proyecto arriba. Todo se guarda en su carpeta, con copias de seguridad automáticas."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="2 · Biblioteca" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Theme.Accent}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" Text="Agrega fuentes de renders, fondos, vídeos, sonidos y música. Los archivos originales no se mueven."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="3 · Voice Lab" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Theme.Accent}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" Text="Registra los personajes y su voz (Loquendo, SAPI o TTS7) o usa voces grabadas."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="4 · Guion" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Theme.Accent}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" Text="Episodios, escenas y bloques. El panel de abajo (Editor, Preview, Director) se agranda con el divisor o con «Ampliar»."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="5 · Director" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Theme.Accent}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" Text="Escribe la escena con [FONDO], [MOSTRAR], [CAMARA], [CINE], [GESTO], [DESENFOQUE]… o deja que la IA la dirija."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="6 · VEGAS" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Theme.Accent}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" Text="Mira la preview y exporta la escena o el episodio: pistas, keyframes y efectos editables en VEGAS."/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,4,12,0" Background="{DynamicResource Theme.SurfaceAlt}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Regla de la biblioteca"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                                           Text="La estructura de carpetas aporta metadata, pero no la impone. Una carpeta puede representar un personaje, un canal, un pack o simplemente una colección. Las expresiones son opcionales."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LibraryTab" IsEnabled="False">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Margin="0,0,6,0"/><TextBlock Text="Biblioteca"/></StackPanel></TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="LibrarySourcesRow" Height="1*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="LibraryAssetsRow" Height="3*" MinHeight="160"/>
                    </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Fuentes"/>
                    <StackPanel x:Name="LibraryActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Margin="5,0" Padding="12,5" Content="Agregar fuente…" Style="{StaticResource AccentButton}" Click="AddSource_Click"/>
                        <Button Margin="5,0" Padding="12,5" Content="Editar reglas…" Click="EditSource_Click"/>
                        <Button Margin="5,0" Padding="12,5" Content="Reubicar…" Click="RelinkSource_Click"/>
                        <Button Margin="5,0" Padding="12,5" Content="Reescanear" Click="RescanSource_Click"/>
                        <Button Margin="5,0" Padding="12,5" Content="Reescanear todas" Click="RescanAll_Click"/>
                        <Button Margin="5,0,0,0" Padding="12,5" Content="Quitar fuente" Click="RemoveSource_Click"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Padding="12,4" Content="Importar de otro proyecto…" Click="ImportFromProject_Click"
                            ToolTip="Trae la biblioteca (fuentes, reglas, clasificación y etiquetas), los perfiles de voz y los personajes de otro proyecto, sin duplicar lo que ya está ni tocar el otro proyecto."/>
                    <TextBlock x:Name="MainLibraryText" Margin="16,0,8,0" VerticalAlignment="Center" Text="Sin biblioteca principal."/>
                    <CheckBox x:Name="FollowMainLibraryCheck" Margin="0,0,8,0" VerticalAlignment="Center" Content="Seguirla" Click="FollowMainLibrary_Click"
                              ToolTip="Este proyecto recibe las fuentes y los recursos nuevos de la biblioteca principal cada vez que lo abres. Nada de aquí se borra."/>
                    <Button x:Name="SyncMainLibraryButton" Margin="0,0,8,0" Padding="10,4" Content="Actualizar ahora" Click="SyncMainLibrary_Click"/>
                    <Button x:Name="SetMainLibraryButton" Padding="10,4" Content="Usar este proyecto como biblioteca principal" Click="SetMainLibrary_Click"
                            ToolTip="Los demás proyectos podrán seguir la biblioteca de este. Solo la biblioteca: perfiles y personajes se pasan con «Importar de otro proyecto»."/>
                </WrapPanel>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Ruta" Binding="{Binding RootPath}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="80"/>
                        <DataGridTextColumn Header="Assets" Binding="{Binding AssetCount}" Width="80"/>
                        <DataGridTextColumn Header="Sin fondo" Binding="{Binding NeedsCutoutCount}" Width="90"/>
                        <DataGridTextColumn Header="Faltantes" Binding="{Binding MissingCount}" Width="80"/>
                        <DataGridTextColumn Header="Último escaneo" Binding="{Binding LastScanText}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                    <GridSplitter Grid.Row="2" Height="6" Margin="0,6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  ToolTip="Arrastra para repartir el espacio entre fuentes y assets"/>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    <StackPanel Margin="0,4,0,8">
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Assets catalogados"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{DynamicResource Theme.TextMuted}" Text="Texto:"/>
                                <TextBox x:Name="AssetSearchBox" Width="200" Height="28" TextChanged="AssetSearchBox_TextChanged" KeyDown="AssetSearchBox_KeyDown" ToolTip="Nombre, sujeto, ruta, colección o descripción. Pulsa Buscar o Enter."/>
                                <ComboBox x:Name="AssetKindFilterBox" Width="115" Height="28" Margin="6,0,0,0" DisplayMemberPath="Name" SelectionChanged="AssetFilterSelection_Changed"/>
                                <ComboBox x:Name="AssetSourceFilterBox" Width="155" Height="28" Margin="6,0,0,0" DisplayMemberPath="Name" SelectionChanged="AssetSourceFilter_SelectionChanged"/>
                                <ComboBox x:Name="AssetFolderFilterBox" Width="220" Height="28" Margin="6,0,0,0" DisplayMemberPath="Name" SelectionChanged="AssetFilterSelection_Changed" ToolTip="Carpetas y subcarpetas de la fuente seleccionada"
                                          ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True">
                                    <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                                </ComboBox>
                                <Button Margin="6,0,0,0" Padding="12,4" Content="Buscar" Style="{StaticResource AccentButton}" Click="AssetSearch_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel>
                            <Button Margin="0,0,12,4" Padding="9,4" Content="Editar etiquetas de la selección…" Click="EditDirectorAssetTags_Click"/>
                            <Button Margin="0,0,12,4" Padding="9,4" Content="Editar tipo / sujeto…" Click="EditAssetClassification_Click" ToolTip="Actualiza los seleccionados o todos los resultados filtrados"/>
                            <TextBlock x:Name="AssetFilterStatusText" VerticalAlignment="Center" Margin="0,0,12,4" Foreground="{DynamicResource Theme.TextMuted}"/>
                            <TextBlock x:Name="AssetVisionProviderLabel" VerticalAlignment="Center" Margin="0,0,6,4" Text="Visión:"/>
                            <ComboBox x:Name="AssetVisionModelBox" Width="240" Height="29" Margin="0,0,6,4" VerticalContentAlignment="Center" SelectionChanged="AiModelSelectionChanged"/>
                            <Button Margin="0,0,7,4" Padding="9,4" Content="Configurar IA…" Click="ConfigureAi_Click"/>
                            <Button Margin="0,0,7,4" Padding="9,4" Content="Recargar modelos" Click="RefreshOllamaModels_Click" ToolTip="Vuelve a leer los modelos instalados en Ollama"/>
                            <Button Margin="0,0,7,4" Padding="9,4" Content="IA: analizar imágenes seleccionadas" Click="AnalyzeDirectorAssets_Click"
                                    ToolTip="Imágenes y GIF (primer fotograma) con el modelo de visión. Varias seleccionadas = esas; sin selección (o con una) y con un filtro, pregunta si analizar todo el filtro. Conserva las etiquetas por hash y modelo."/>
                            <Button Margin="0,0,7,4" Padding="9,4" Content="IA: analizar medios seleccionados" Click="AnalyzeDirectorMedia_Click"
                                    ToolTip="Todo tipo de recurso: imágenes con el modelo de visión; música, SFX, videos y GIF por su nombre con el modelo del Director (varios por petición, pocos tokens). Los audios cuyo nombre no dice nada se pueden escuchar después con Gemini (pregunta antes)."/>
                            <Button x:Name="AssetCancelAnalysisButton" Margin="0,0,7,4" Padding="8,4" Content="Cancelar análisis" IsEnabled="False" Click="AiCancel_Click"/>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource Theme.TextMuted}" Text="Edita Descripción IA en la celda; doble clic para etiquetas completas."/>
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="AssetsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" CellEditEnding="AssetsGrid_CellEditEnding" MouseDoubleClick="AssetsGrid_MouseDoubleClick"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descripción IA (editable)" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="220"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Personaje / sujeto" Binding="{Binding Subject}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Colección" Binding="{Binding Collection}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fondo" Binding="{Binding Cutout}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fuente" Binding="{Binding SourceName}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ruta relativa" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="90" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="VoiceLabTab" IsEnabled="False">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="♪" Margin="0,0,6,0"/><TextBlock Text="Voice Lab"/></StackPanel></TabItem.Header>
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Personajes y perfiles de voz"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" Text="La identidad base vive en el personaje; velocidad, pitch y volumen podrán sobreescribirse por diálogo más adelante."/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="VoiceBridgeStatusText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}"/>
                            <Button Margin="12,0,0,0" Padding="11,4" Content="Voces en los selectores…" Click="EditVoiceSelector_Click"
                                    ToolTip="Qué voces TTS aparecen en «Voz» del Editor, en Diálogos y en Voces grabadas (TTS7, SAPI4 Juan/Antonio, SAPI5 Juan/IVONA…). Añade o quita voces, por ejemplo al instalar voces nuevas."/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Personajes">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="CharactersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0"
                                          SelectionChanged="CharactersGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Personaje" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Voz base" Binding="{Binding VoiceProfileName}" Width="145"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox x:Name="NewCharacterNameBox" Height="30" MinWidth="180" VerticalContentAlignment="Center"/>
                                    <Button Margin="8,0,0,0" Padding="12,4" Content="Agregar" Click="AddCharacter_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Padding="11,4" Content="Asignar perfil seleccionado" Click="AssignVoiceProfile_Click"/>
                                    <Button Margin="8,0,0,0" Padding="11,4" Content="Eliminar" Click="DeleteCharacter_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Perfil de voz">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center" Text="Perfil guardado:"/>
                                <DockPanel Grid.Column="1">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Padding="10,4" Content="Nuevo" Click="NewVoiceProfile_Click"/>
                                        <Button Margin="8,0,0,0" Padding="10,4" Content="Eliminar" Click="DeleteVoiceProfile_Click"/>
                                    </StackPanel>
                                    <ComboBox x:Name="VoiceProfileCombo" Height="30" DisplayMemberPath="Name"
                                              SelectionChanged="VoiceProfileCombo_SelectionChanged"/>
                                </DockPanel>

                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Nombre del perfil:" Margin="0,8,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="VoiceProfileNameBox" Height="30" Margin="0,8,0,0" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Motor:" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="VoiceProviderCombo" Height="30" Margin="0,8,0,0"
                                          DisplayMemberPath="Name" SelectionChanged="VoiceProviderCombo_SelectionChanged"/>

                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Voz:" Margin="0,8,0,0"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="VoiceIdCombo" Height="30" Margin="0,8,0,0" IsTextSearchEnabled="True"/>

                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Pitch base:" Margin="0,12,0,0"/>
                                <Grid Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="VoicePitchSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="VoicePitchSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="VoicePitchValueText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50"/>
                                </Grid>

                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Velocidad base:" Margin="0,12,0,0"/>
                                <Grid Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="VoiceSpeedEnabledCheck" VerticalAlignment="Center" Content="Fijar"
                                              Checked="VoiceSpeedEnabled_Changed" Unchecked="VoiceSpeedEnabled_Changed"/>
                                    <Slider Grid.Column="2" x:Name="VoiceSpeedSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1"
                                            IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="VoiceSpeedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="3" x:Name="VoiceSpeedValueText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Auto"/>
                                </Grid>

                                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Volumen:" Margin="0,12,0,0"/>
                                <Grid Grid.Row="6" Grid.Column="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="VoiceVolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="VoiceVolumeSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="VoiceVolumeValueText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100"/>
                                </Grid>

                                <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Sample rate (TTS7):" Margin="0,10,0,0"/>
                                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="VoiceSampleRateCombo" Height="30" Width="130" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                                <Grid Grid.Row="8" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="Texto de prueba"/>
                                    <TextBox Grid.Row="1" x:Name="VoicePreviewTextBox" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MinHeight="100"
                                             Text="Hola amigos de YouTube, esto es una prueba del Voice Lab de Loquendo AI."/>
                                </Grid>

                                <DockPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <TextBlock x:Name="VoiceLabStatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" Text="Selecciona un motor y una voz."/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="VoicePreviewButton" Padding="12,5" Content="▶ Escuchar" Click="PreviewVoice_Click"/>
                                        <Button Margin="8,0,0,0" Padding="12,5" Content="■ Detener" Click="StopVoicePreview_Click"/>
                                        <Button Margin="8,0,0,0" Padding="12,5" Content="Guardar perfil" Style="{StaticResource AccentButton}" Click="SaveVoiceProfile_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="DialogueTab" IsEnabled="False">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="❝" Margin="0,0,6,0"/><TextBlock Text="Diálogos"/></StackPanel></TabItem.Header>
                <!-- Módulo de diálogos (1.2.0): escribe, importa o genera con IA las líneas de un episodio, genera sus
                     voces con TTS y las exporta a escenas como voces grabadas. -->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="140"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="10,8">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <TextBlock Text="Guion de diálogos:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DialogueSetCombo" Width="210" Height="28" VerticalContentAlignment="Center" DisplayMemberPath="Name"
                                          SelectionChanged="DialogueSetCombo_SelectionChanged" ToolTip="Cada guion se guarda solo en la carpeta «dialogos» del proyecto"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Nuevo" Click="NewDialogueSet_Click"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Renombrar" Click="RenameDialogueSet_Click"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Eliminar" Click="DeleteDialogueSet_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <TextBlock Text="Leer como:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="DialogueParseModeCombo" Width="150" Height="28" VerticalContentAlignment="Center" SelectedIndex="0"
                                          ToolTip="Recomendado: «Nombre: texto», una línea sin nombre es narración y «[ESCENA] título» corta. Análisis: además entiende guiones de cine, diálogos de novela («—Hola —dijo Bart»), chats, tiempos, numeración y encabezados.">
                                    <ComboBoxItem Content="Formato recomendado"/>
                                    <ComboBoxItem Content="Modo análisis"/>
                                </ComboBox>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Importar archivo…" Click="ImportDialogueFile_Click"
                                        ToolTip="Texto (.txt, .md), Word (.docx), Excel (.xlsx) o CSV. Los .doc y .xls antiguos: guárdalos antes como .docx / .xlsx."/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Pegar / escribir texto…" Click="PasteDialogueText_Click"
                                        ToolTip="Pega aquí lo que te dio una IA web o escribe el guion en el formato recomendado"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Formato recomendado…" Click="ShowDialogueFormat_Click"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Exportar .txt" Click="ExportDialogueText_Click"
                                        ToolTip="Guarda el guion en el formato recomendado (se puede volver a importar)"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Card}" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DialogueStoryBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="DialogueStoryBox_TextChanged"
                                     ToolTip="Historia para la IA: de qué trata, el tono y cómo termina. Se usa en «Prompt maestro…» y en «Generar diálogos con IA»."/>
                            <WrapPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="560">
                                <Button Margin="0,2,6,2" Padding="9,3" Content="Prompt maestro…" Click="DialogueMasterPrompt_Click"
                                        ToolTip="Elige qué personajes participan y copia el prompt para una IA web (ChatGPT, Gemini, Claude…); su respuesta se pega con «Pegar / escribir texto…»"/>
                                <TextBlock Text="Modelo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="DialogueModelBox" Width="210" Height="28" VerticalContentAlignment="Center" Margin="0,2,6,2"
                                          ToolTip="Los mismos modelos del Director IA («Configurar IA» en la pestaña Director IA)"/>
                                <TextBlock Text="Líneas:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="DialogueAiLinesBox" Width="44" Height="26" Text="30" VerticalContentAlignment="Center" Margin="0,2,6,2"
                                         ToolTip="Líneas aproximadas que pedir (hasta 150 por generación; genera otra vez para añadir más)"/>
                                <Button x:Name="DialogueAiButton" Margin="0,2,6,2" Padding="10,3" Content="Generar diálogos con IA" Style="{StaticResource AccentButton}"
                                        Click="GenerateDialogueAi_Click" ToolTip="Solo escribe los diálogos (no monta escenas) con el prompt maestro y los personajes elegidos"/>
                                <Button x:Name="DialogueCancelButton" Margin="0,2,0,2" Padding="10,3" Content="Cancelar" IsEnabled="False" Click="CancelDialogueWork_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="DialogueGrid" Grid.Row="2" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" SelectionMode="Extended" RowHeaderWidth="0" CellEditEnding="DialogueGrid_CellEditEnding"
                              KeyDown="DialogueGrid_KeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶" Width="26" Height="22" Padding="0" Click="PlayDialogueRow_Click" Visibility="{Binding LineVisibility}"
                                                ToolTip="Escuchar esta línea (la genera si aún no tiene audio)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Tipo" Width="105" SortMemberPath="KindText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding KindText}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding KindChoices}" SelectedItem="{Binding KindText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Quién habla" Width="140" SortMemberPath="Speaker">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Speaker}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding SpeakerChoices}" Text="{Binding Speaker, UpdateSourceTrigger=LostFocus}"
                                                  ToolTip="Un personaje registrado usa su perfil; cualquier otro nombre es un NPC"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Voz asignada" Width="215" SortMemberPath="VoiceText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ComboBox Height="24" ItemsSource="{Binding VoiceChoices}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding VoiceChoice, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NpcVisibility}"
                                                      ToolTip="Voz de este NPC: la del perfil NPC, cualquier voz TTS7 o un perfil guardado"/>
                                            <DockPanel Visibility="{Binding ProfileVisibility}">
                                                <Button DockPanel.Dock="Right" Content="✎" Width="24" Height="22" Padding="0" Margin="4,0,0,0" Click="EditDialogueProfile_Click"
                                                        ToolTip="Editar el perfil de este personaje en Voice Lab"/>
                                                <TextBlock Text="{Binding VoiceText}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding VoiceText}"/>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Pitch" Binding="{Binding PitchText, UpdateSourceTrigger=LostFocus}" Width="50"/>
                            <DataGridTextColumn Header="Vel." Binding="{Binding SpeedText, UpdateSourceTrigger=LostFocus}" Width="46"/>
                            <DataGridTextColumn Header="Vol." Binding="{Binding VolumeText, UpdateSourceTrigger=LostFocus}" Width="46"/>
                            <DataGridTextColumn Header="Diálogo" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Margin" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Comentario" Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}" Width="150"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="ToolTip" Value="{Binding StateDetail}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Duración" Binding="{Binding DurationText}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource Card}" Padding="10,6">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <Button Padding="9,3" Content="+ Línea" Click="AddDialogueLine_Click" ToolTip="Añade una línea debajo de la seleccionada"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="+ Corte de escena" Click="AddDialogueScene_Click"
                                        ToolTip="Una escena nueva empieza aquí (su título va en «Diálogo»)"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Duplicar" Click="DuplicateDialogueLines_Click"/>
                                <Button Margin="6,0,0,0" Width="30" Padding="0" Content="↑" Click="MoveDialogueUp_Click" ToolTip="Subir la selección"/>
                                <Button Margin="6,0,0,0" Width="30" Padding="0" Content="↓" Click="MoveDialogueDown_Click" ToolTip="Bajar la selección"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Eliminar" Click="DeleteDialogueLines_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <TextBlock Text="Selección →" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Theme.TextMuted}"/>
                                <ComboBox x:Name="DialogueBulkSpeakerCombo" Width="140" Height="28" IsEditable="True" VerticalContentAlignment="Center"
                                          ToolTip="Personaje registrado o nombre de NPC para las filas seleccionadas"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Asignar quién habla" Click="AssignDialogueSpeaker_Click"/>
                                <ComboBox x:Name="DialogueBulkVoiceCombo" Width="170" Height="28" Margin="10,0,0,0" DisplayMemberPath="Name" VerticalContentAlignment="Center"
                                          ToolTip="Voz para las filas NPC seleccionadas (las de personajes con perfil usan su perfil)"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Asignar voz NPC" Click="AssignDialogueVoice_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="Pitch" VerticalAlignment="Center"/>
                                <TextBox x:Name="DialogueBulkPitchBox" Width="40" Height="26" Margin="4,0,8,0" VerticalContentAlignment="Center" ToolTip="Vacío = el del perfil"/>
                                <TextBlock Text="Vel." VerticalAlignment="Center"/>
                                <TextBox x:Name="DialogueBulkSpeedBox" Width="40" Height="26" Margin="4,0,8,0" VerticalContentAlignment="Center" ToolTip="Vacío = el del perfil"/>
                                <TextBlock Text="Vol." VerticalAlignment="Center"/>
                                <TextBox x:Name="DialogueBulkVolumeBox" Width="40" Height="26" Margin="4,0,8,0" VerticalContentAlignment="Center" ToolTip="Vacío = el del perfil"/>
                                <Button Padding="9,3" Content="Ajustar selección" Click="ApplyDialogueProsody_Click"
                                        ToolTip="Solo para estas líneas: el perfil no cambia (su base se edita en Voice Lab)"/>
                                <TextBox x:Name="DialogueSearchBox" Width="130" Height="26" Margin="14,0,0,0" VerticalContentAlignment="Center" KeyDown="DialogueSearchBox_KeyDown"
                                         ToolTip="Escribe y pulsa Intro: selecciona la siguiente línea que lo contenga (texto, personaje o comentario)"/>
                                <Button Margin="6,0,0,0" Padding="9,3" Content="Buscar" Click="FindDialogue_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource PlayerBar}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="DialoguePlayAllButton" MinWidth="130" Height="29" Padding="10,3" Content="▶ Reproducir todo" Style="{StaticResource AccentButton}"
                                        Click="PlayAllDialogue_Click" ToolTip="Desde la línea seleccionada (o la primera) hasta el final, de corrido"/>
                                <Button Margin="6,0,0,0" MinWidth="82" Height="29" Padding="10,3" Content="■ Detener" Click="StopDialoguePlayback_Click"/>
                                <Button x:Name="DialogueGenerateButton" Margin="14,0,0,0" MinWidth="120" Height="29" Padding="10,3" Content="Generar audios"
                                        Click="GenerateDialogueAudio_Click" ToolTip="Genera con TTS las líneas que aún no tienen audio (las demás se reutilizan)"/>
                                <Button Margin="6,0,0,0" Height="29" Padding="10,3" Content="Regenerar selección" Click="RegenerateDialogueAudio_Click"
                                        ToolTip="Vuelve a sintetizar las líneas seleccionadas"/>
                            </StackPanel>
                            <TextBlock x:Name="DialogueStatsText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Theme.TextMuted}" Text="0 líneas"/>
                            <TextBlock x:Name="DialogueStatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                       Text="Abre un proyecto. Importa, pega, escribe o genera con IA los diálogos."/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource Card}" Padding="10,8">
                        <WrapPanel>
                            <TextBlock Text="Exportar a escenas →" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <TextBlock Text="Episodio:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="DialogueEpisodeCombo" Width="220" Height="28" VerticalContentAlignment="Center" DisplayMemberPath="Name"
                                      DropDownOpened="DialogueEpisodeCombo_DropDownOpened" ToolTip="Las escenas se crean al final de este episodio"/>
                            <ComboBox x:Name="DialogueExportModeCombo" Width="300" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectedIndex="1"
                                      SelectionChanged="DialogueExportMode_SelectionChanged">
                                <ComboBoxItem Content="Una escena con todas (Director IA · episodio)"/>
                                <ComboBoxItem Content="Repartir en escenas (cortes y límite)"/>
                            </ComboBox>
                            <TextBlock x:Name="DialoguePerSceneLabel" Text="Líneas por escena:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="DialoguePerSceneBox" Width="40" Height="26" Text="40" VerticalContentAlignment="Center"
                                     ToolTip="Máximo 40 (el límite del Director IA por escena). Una escena más larga se parte en partes iguales."/>
                            <Button Margin="10,0,0,0" MinWidth="150" Padding="10,4" Content="Exportar a escenas" Style="{StaticResource AccentButton}"
                                    Click="ExportDialogueToScenes_Click"
                                    ToolTip="Crea escenas NUEVAS al final del episodio con las líneas como voces grabadas (WAV + texto + su voz). Después: Director IA en modo «Montar voces grabadas»."/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ScriptTab" IsEnabled="False">
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="✎" Margin="0,0,6,0"/><TextBlock Text="Guion"/></StackPanel></TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ScriptNavColumn" Width="250" MinWidth="170" MaxWidth="560"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="480"/>
                    </Grid.ColumnDefinitions>

                    <!-- Episodios y escenas, apilados (antes eran dos columnas que le quitaban ancho a todo lo demás). -->
                    <Grid x:Name="ScriptNavPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="140"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Episodios"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="EpisodesList" DisplayMemberPath="Display" SelectionChanged="EpisodesList_SelectionChanged"/>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="EpisodeNumberBox" Height="28" VerticalContentAlignment="Center" ToolTip="Número"/>
                                    <TextBox Grid.Column="1" x:Name="EpisodeTitleBox" Margin="6,0,0,0" Height="28" VerticalContentAlignment="Center" ToolTip="Título"/>
                                </Grid>
                                <TextBox Grid.Row="2" x:Name="EpisodeSynopsisBox" Margin="0,6,0,0" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Sinopsis"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Padding="9,4" Content="Nuevo" Click="NewEpisode_Click"/>
                                    <Button Margin="6,0,0,0" Padding="9,4" Content="Guardar" Click="SaveEpisode_Click"/>
                                    <Button Margin="6,0,0,0" Padding="9,4" Content="Eliminar" Click="DeleteEpisode_Click"/>
                                </StackPanel>
                            </Grid>
                            </DockPanel>
                        </Border>
                        <GridSplitter Grid.Row="1" Height="6" Margin="0,4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Escenas"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="ScenesList" DisplayMemberPath="Display" SelectionChanged="ScenesList_SelectionChanged"/>
                                <TextBox Grid.Row="1" x:Name="SceneTitleBox" Margin="0,8,0,0" Height="28" VerticalContentAlignment="Center" ToolTip="Título de la escena"/>
                                <TextBox Grid.Row="2" x:Name="SceneNotesBox" Margin="0,6,0,0" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Notas de dirección"/>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Padding="9,4" Content="Nueva" Click="NewScene_Click"/>
                                    <Button Margin="6,0,0,0" Padding="9,4" Content="Guardar" Click="SaveScene_Click"/>
                                    <Button Margin="6,0,0,0" Padding="9,4" Content="Eliminar" Click="DeleteScene_Click"/>
                                </StackPanel>
                            </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <GridSplitter x:Name="ScriptNavSplitter" Grid.Column="1" Width="6" Margin="4,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Arrastra para cambiar el ancho de episodios y escenas"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ScriptBlocksRow" Height="1*" MinHeight="110"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ScriptToolsRow" Height="2*" MinHeight="230"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,7">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="Bloques de escena"/>
                                <TextBlock x:Name="ScriptSceneSummaryText" Margin="0,3,0,0" Foreground="{DynamicResource Theme.TextMuted}" Text="Selecciona una escena."/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="ToolsFocusButton" Margin="0,0,14,0" Padding="10,4" Content="▲ Ampliar panel" Click="ToggleToolsFocus_Click"
                                        ToolTip="Deja el panel de abajo (Editor, Preview, Director…) a pantalla completa, ocultando episodios, escenas y la tabla de bloques. Vuelve a pulsar para restaurar."/>
                                <Button Padding="10,4" Content="+ Diálogo" Click="AddDialogueBlock_Click"/>
                                <ComboBox x:Name="QuickBlockTypeCombo" Width="120" Height="28" Margin="6,0,0,0" DisplayMemberPath="Name"/>
                                <Button Margin="4,0,0,0" Padding="9,4" Content="+ Bloque" Click="AddTypedBlock_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid x:Name="ScriptBlocksPane" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="ScriptBlocksGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                      SelectionChanged="ScriptBlocksGrid_SelectionChanged" PreviewKeyDown="ScriptBlocksGrid_KeyDown"
                                      AllowDrop="True" PreviewMouseLeftButtonDown="ScriptBlocksGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="ScriptBlocksGrid_PreviewMouseLeftButtonUp" PreviewMouseMove="ScriptBlocksGrid_PreviewMouseMove"
                                      DragOver="ScriptBlocksGrid_DragOver" DragLeave="ScriptBlocksGrid_DragLeave" Drop="ScriptBlocksGrid_Drop"
                                      CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="42"/>
                                    <DataGridTextColumn Header="Tiempo" Binding="{Binding Start}" Width="76"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="95"/>
                                    <DataGridTextColumn Header="Personaje / asset" Binding="{Binding Subject}" Width="145"/>
                                    <DataGridTextColumn Header="Contenido" Binding="{Binding Content}" Width="*"/>
                                    <DataGridTextColumn Header="Audio" Binding="{Binding AudioState}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Padding="9,3" Content="↑" Click="MoveBlockUp_Click" ToolTip="Subir uno o varios bloques seleccionados (también puedes arrastrarlos en la tabla)"/>
                                    <Button Margin="5,0,0,0" Padding="9,3" Content="↓" Click="MoveBlockDown_Click" ToolTip="Bajar uno o varios bloques seleccionados"/>
                                    <Button Margin="5,0,0,0" Padding="9,3" Content="Eliminar" Click="DeleteBlock_Click" ToolTip="Eliminar seleccionados; Ctrl alterna, Shift elige rangos y Tab amplía la selección"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="PlayGeneratedLineButton" Padding="10,3" Content="▶ Audio" Click="PlayGeneratedLine_Click"/>
                                    <Button Margin="4,0,0,0" Width="30" Padding="0" Content="■" Click="StopScriptAudio_Click" ToolTip="Detener el audio que suena (voz, música o SFX)"/>
                                    <Button x:Name="GenerateSceneVoicesButton" Margin="6,0,0,0" Padding="11,3" Content="Generar voces de escena" Style="{StaticResource AccentButton}" Click="GenerateSceneVoices_Click"/>
                                    <Button Margin="6,0,0,0" Padding="9,3" Content="Regenerar bloque con TTS" Click="RegenerateImportedVoice_Click" ToolTip="Pide confirmación y sustituye la voz grabada del bloque por TTS con la voz asignada a la toma (no la del personaje). La grabación se conserva para restaurarla."/>
