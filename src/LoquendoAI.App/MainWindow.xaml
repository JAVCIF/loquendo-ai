                                             ToolTip="Personajes: tamaño del render, también con encuadre automático (130 = 30 % más grande; puede salir de su carril). Se guarda con el bloque. Otros: agranda o achica ancho y alto a la vez; pulsa ✓ y guarda el bloque."/>
                                    <Button Content="✓" Width="26" Height="25" Margin="0,0,10,0" Click="ApplyEditorScale_Click" ToolTip="Aplicar la escala a Ancho y Alto"/>
                                    <TextBlock Text="Mover X:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VisualOffsetXBox" Width="54" Height="25" Margin="5,0,10,0" Text="0" VerticalContentAlignment="Center" ToolTip="Píxeles; negativo mueve a la izquierda."/>
