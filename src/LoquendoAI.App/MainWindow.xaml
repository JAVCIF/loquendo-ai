                                    <Grid Grid.Row="4" Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DirectorStatusText" Text="Selecciona una escena y prepara el borrador." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="DirectorValidateButton" Grid.Column="1" Margin="0,0,7,0" Padding="10,4" Content="Validar edición" Click="ValidateDirectorDraft_Click"/>
                                        <Button x:Name="DirectorApplyButton" Grid.Column="2" MinWidth="145" Padding="10,4" Content="Aplicar al guion" Style="{StaticResource AccentButton}" IsEnabled="False" Click="DirectorApply_Click"/>
                                    </Grid>
                                </Grid>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="✦" Margin="0,0,6,0"/><TextBlock Text="Director IA"/></StackPanel></TabItem.Header>
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1*" MinHeight="60"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="2*" MinHeight="60"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="AiDirectorIntroLabel" Text="Selecciona una escena. La IA preparará un borrador revisable usando los recursos catalogados." TextWrapping="Wrap"/>
                                    <WrapPanel Grid.Row="1" Margin="0,9,0,8">
                                        <TextBlock x:Name="AiDirectorProviderLabel" VerticalAlignment="Center" Text="Modelo:" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="AiDirectorModelBox" Width="260" Height="29" VerticalContentAlignment="Center" SelectionChanged="AiModelSelectionChanged"/>
                                        <TextBlock x:Name="AiEffortLabel" VerticalAlignment="Center" Margin="8,0,4,0" Text="Esfuerzo:" Visibility="Collapsed"/>
                                        <ComboBox x:Name="AiEffortCombo" Width="125" Height="29" VerticalContentAlignment="Center" Visibility="Collapsed"
                                                  ToolTip="Cuánto razona el modelo antes de responder (solo modelos que lo admiten). Más esfuerzo = más lento y más tokens. El predeterminado se cambia en «Configurar IA»."/>
                                        <Button Margin="6,0,0,0" Padding="9,4" Content="Configurar IA…" Click="ConfigureAi_Click"/>
                                        <Button Margin="6,0,0,0" Padding="9,4" Content="Prompt maestro…" Click="ViewMasterPrompt_Click" ToolTip="Ver, editar o restablecer las instrucciones base enviadas al modelo para este proyecto"/>
                                        <Button Margin="6,0,0,0" Padding="9,4" Content="Recargar modelos" Click="RefreshOllamaModels_Click" ToolTip="Vuelve a leer los modelos instalados en Ollama"/>
                                        <TextBlock VerticalAlignment="Center" Text="Modo:" Margin="14,0,6,0"/>
                                        <ComboBox x:Name="AiDirectorModeCombo" Width="240" SelectedIndex="0">
                                            <ComboBoxItem Content="Historia desde prompt"/>
                                            <ComboBoxItem Content="Montar voces grabadas"/>
                                        </ComboBox>
                                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="Las voces grabadas deben estar incorporadas a la escena."/>
                                        <Button x:Name="VegasCatalogButton" Margin="12,0,0,0" Padding="10,2" Content="Transiciones VEGAS…" Click="ImportVegasTransitionCatalog_Click"
                                                ToolTip="Importa transiciones_vegas.txt (script scripts/vegas/Listar_transiciones_14_o_superior.cs) para que el Director IA y el editor usen los plugins que tienes instalados (NewBlue, Sapphire, Boris…)."/>
                                    </WrapPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="AiDirectorPromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 ToolTip="Describe la trama, los personajes, el tono, los lugares, los recursos y la duración deseada."/>
                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                            <Button x:Name="AiGenerateButton" Padding="10,4" Content="Generar borrador con IA" Style="{StaticResource AccentButton}" Click="AiGenerateDraft_Click"/>
                                            <Button x:Name="AiEpisodeButton" Margin="6,0,0,0" Padding="10,4" Content="Generar episodio (varias escenas)" Click="AiGenerateEpisode_Click" ToolTip="Historia: la IA divide la premisa en escenas y dirige cada una. Voces grabadas: reparte las tomas de la escena seleccionada en escenas nuevas. Siempre crea escenas nuevas al final del episodio."/>
                                            <Button x:Name="AiPickDraftAssetButton" Margin="6,0,0,0" Padding="10,4" Content="Elegir recurso de fila…" Click="PickDirectorDraftAsset_Click" ToolTip="Sustituye el fondo, render, música o efecto de la fila seleccionada"/>
                                            <Button Margin="6,0,0,0" Padding="10,4" Content="Copiar borrador" Tag="ia" Click="CopyDraftForDirector_Click" ToolTip="Copia el borrador como bloque o JSON completo para conservar voces y ajustes; pégalo en Director (prompt) para editarlo línea por línea"/>
                                            <Button Margin="6,0,0,0" Padding="10,4" Content="Borrar borrador" Tag="ia" Click="ClearDirectorDraft_Click" ToolTip="Descarta este borrador (el guion de la escena no cambia). Generar otro también lo reemplaza."/>
                                            <Button x:Name="AiCancelButton" Margin="6,0,0,0" Padding="10,4" Content="Cancelar" IsEnabled="False" Click="AiCancel_Click"/>
                                            <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" Text="Revisa los recursos, los diálogos y el orden antes de aplicar."/>
                                        </WrapPanel>
                                    </Grid>
                                    <GridSplitter Grid.Row="3" Height="6" Margin="0,6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                                  ToolTip="Arrastra para dar más espacio a la premisa o a la tabla"/>
                                    <DataGrid x:Name="AiDraftGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" BeginningEdit="DirectorDraftGrid_BeginningEdit" RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Instrucción (editable)" Binding="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="100" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Personaje / recurso" Binding="{Binding Subject}" Width="180" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Texto" Binding="{Binding Text}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Ajustes" Binding="{Binding Parameters}" Width="180" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="210" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DockPanel Grid.Row="5" Margin="0,7,0,0">
                                        <Button x:Name="AiApplyButton" DockPanel.Dock="Right" Padding="10,4" Content="Aplicar borrador al guion" Style="{StaticResource AccentButton}" IsEnabled="False" Click="DirectorApply_Click"/>
                                        <Button x:Name="AiValidateButton" DockPanel.Dock="Right" Margin="0,0,7,0" Padding="10,4" Content="Validar edición" Click="ValidateDirectorDraft_Click"/>
                                        <TextBlock x:Name="AiDirectorStatusText" Text="Escribe la premisa y elige un modelo de Ollama." TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <DockPanel Grid.Row="4" Margin="2,6,2,0">
                            <TextBlock x:Name="ScriptStatusText" DockPanel.Dock="Left" Foreground="{DynamicResource Theme.TextMuted}" Text="Crea un episodio y una escena para empezar."/>
                            <TextBlock x:Name="ScriptDurationText" DockPanel.Dock="Right" FontWeight="SemiBold" Text="Duración: 00:00.000"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Barra de estado. -->
        <Border Grid.Row="3" Background="{DynamicResource Theme.StatusBar}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelScanButton" Margin="0,0,10,0" Padding="10,3"
                            Content="Cancelar escaneo" Visibility="Collapsed" Click="CancelScan_Click"/>
                    <ProgressBar x:Name="WorkProgress" Width="220" Height="10" Visibility="Collapsed" IsIndeterminate="True"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis"
                           Text="Listo."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
