                                        <Button Content="Asignar personaje" Margin="5,0,0,0" Padding="9,4" Click="AssignRecordedVoiceCharacter_Click" ToolTip="Asigna el personaje (o el nombre escrito) a las tomas seleccionadas"/>
                                        <ComboBox x:Name="RecordedVoiceProfileCombo" Width="185" Margin="12,0,0,0" DisplayMemberPath="Name" ToolTip="Opcional. Es la ÚNICA voz que se usa si luego pulsas «Regenerar bloque con TTS» (con confirmación). La grabación nunca se reemplaza sola."/>
                                        <Button Content="Asignar voz" Margin="5,0,0,0" Padding="9,4" Click="AssignRecordedVoiceProfile_Click"/>
