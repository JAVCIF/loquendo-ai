                                </StackPanel>
                            </DockPanel>
                        </Grid>

                        <GridSplitter x:Name="ScriptToolsSplitter" Grid.Row="2" Height="6" Margin="0,6" HorizontalAlignment="Stretch"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Arrastra para dar más espacio a la tabla o al panel de abajo"/>

                        <Grid Grid.Row="3">
                            <TabControl x:Name="ScriptToolsTabs" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}">
                                <TabItem>
                                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="✎" Margin="0,0,6,0"/><TextBlock Text="Editor"/></StackPanel></TabItem.Header>
                        <Grid Margin="9">
                          <Grid.RowDefinitions>
                              <RowDefinition Height="*"/>
                              <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                           <Grid Margin="0,0,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center" Text="Tipo:"/>
                            <ComboBox Grid.Column="1" x:Name="ScriptBlockTypeCombo" Height="28" DisplayMemberPath="Name" SelectionChanged="ScriptBlockTypeCombo_SelectionChanged"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Text="Personaje:"/>
                            <ComboBox Grid.Column="3" x:Name="ScriptCharacterCombo" Height="28" DisplayMemberPath="Name" SelectionChanged="ScriptCharacterCombo_SelectionChanged"/>

                            <TextBlock Grid.Row="1" x:Name="ScriptAssetLabel" VerticalAlignment="Center" Margin="0,7,0,0" Text="Asset:"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="■" Width="30" Height="28" Padding="0" Margin="4,0,0,0" ToolTip="Detener el audio que suena (voz, música o SFX)" Click="StopScriptAudio_Click"/>
                                <Button x:Name="PreviewAssetButton" DockPanel.Dock="Right" Content="▶" Width="30" Height="28" Padding="0" Margin="6,0,0,0" ToolTip="Escuchar SFX o música seleccionada" Click="PreviewAsset_Click"/>
                                <Button x:Name="ScriptAssetsRefreshButton" DockPanel.Dock="Right" Content="↻" Width="30" Height="28" Padding="0" Margin="6,0,0,0"
                                        ToolTip="Volver a consultar los assets después de un escaneo o cambio de reglas" Click="ScriptAssetsRefresh_Click"/>
                                <Button x:Name="BrowseCatalogAssetButton" DockPanel.Dock="Right" Content="Elegir archivo…" Height="28" Padding="7,2" Margin="6,0,0,0"
                                        ToolTip="Seleccionar un archivo catalogado, aunque quede fuera de los primeros 150" Click="BrowseCatalogAsset_Click"/>
                                <ComboBox x:Name="ScriptAssetCombo" Height="28" DisplayMemberPath="Name" IsTextSearchEnabled="True"
                                          SelectionChanged="ScriptAssetCombo_SelectionChanged"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="10,7,0,0" Text="Voz:"/>
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="ScriptVoiceProfileCombo" Height="28" Margin="0,7,0,0" DisplayMemberPath="Name"
                                      ToolTip="Con qué voz habla: la del perfil del personaje, un perfil o cualquier voz TTS de la lista (Voice Lab › Voces en los selectores)."/>

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,7,0,0" Text="Overrides:"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock VerticalAlignment="Center" Text="Pitch"/><TextBox x:Name="BlockPitchBox" Width="48" Height="26" Margin="5,0,12,0" VerticalContentAlignment="Center" ToolTip="vacío = heredar"/>
                                <TextBlock VerticalAlignment="Center" Text="Vel."/><TextBox x:Name="BlockSpeedBox" Width="48" Height="26" Margin="5,0,12,0" VerticalContentAlignment="Center" ToolTip="vacío = heredar"/>
                                <TextBlock VerticalAlignment="Center" Text="Vol."/><TextBox x:Name="BlockVolumeBox" Width="48" Height="26" Margin="5,0,12,0" VerticalContentAlignment="Center" ToolTip="vacío = heredar"/>
                                <TextBlock VerticalAlignment="Center" Text="Pausa ms"/><TextBox x:Name="BlockPauseBox" Width="65" Height="26" Margin="5,0,0,0" VerticalContentAlignment="Center" Text="0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Vertical" Margin="0,5,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="SfxWaitCheck" Content="Esperar a que termine el SFX" VerticalAlignment="Center" Checked="SfxWaitCheck_Changed" Unchecked="SfxWaitCheck_Changed"/>
                                    <TextBlock Margin="18,0,5,0" Text="Posición:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CharacterPositionCombo" Width="105" Height="25" SelectedIndex="1" ToolTip="Auto reparte a los personajes entre los espacios de la escena.">
                                        <ComboBoxItem Content="izquierda"/><ComboBoxItem Content="centro"/><ComboBoxItem Content="derecha"/><ComboBoxItem Content="auto"/>
                                    </ComboBox>
                                </StackPanel>
                                <WrapPanel x:Name="CharacterFramingPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Encuadre:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CharacterFramingCombo" Width="166" Height="25" Margin="6,0,12,0" SelectedIndex="1"
                                              ToolTip="Auto analiza el área visible; cuerpo y medio conservan la silueta. Primer plano recorta su parte superior.">
                                        <ComboBoxItem Content="Original"/><ComboBoxItem Content="Automático"/><ComboBoxItem Content="Cuerpo entero"/><ComboBoxItem Content="Medio cuerpo"/><ComboBoxItem Content="Primer plano"/>
                                    </ComboBox>
                                    <TextBlock Text="Auto distribuye personajes y quita márgenes transparentes. Puedes corregirlo con ancho, alto y posición."
                                               Width="440" Foreground="{DynamicResource Theme.TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <WrapPanel x:Name="BackgroundBordersPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="BackgroundTrimBordersCheck" Content="Quitar bordes planos del archivo (automático)" IsChecked="True"
                                              VerticalAlignment="Center" ToolTip="Detecta pares de márgenes uniformes dentro de la imagen. Desmárcalo si son parte del dibujo."/>
                                </WrapPanel>
                                <WrapPanel x:Name="VisualTimingPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Duración (ms):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VisualDurationBox" Width="85" Height="25" Margin="6,0,10,0" VerticalContentAlignment="Center"
                                             ToolTip="Vacío: hasta siguiente fondo/imagen, ocultar personaje o fin de escena. En video: duración original."/>
                                    <TextBlock x:Name="VisualTimingHint" Text="Vacío = automático; no retrasa la voz" Foreground="{DynamicResource Theme.TextMuted}" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <WrapPanel x:Name="TransitionOptionsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Fundido:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TransitionStyleCombo" Width="225" Height="25" Margin="6,0,12,0" SelectedIndex="0"
                                              SelectionChanged="TransitionStyleCombo_SelectionChanged">
                                        <ComboBoxItem Content="Entrada (desde negro)"/>
                                        <ComboBoxItem Content="Salida (hacia negro)"/>
                                        <ComboBoxItem Content="Cambio a mitad (negro)"/>
                                        <ComboBoxItem Content="Cruce de capas"/>
                                    </ComboBox>
                                    <TextBlock Text="Duración (ms):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TransitionDurationBox" Width="75" Height="25" Margin="6,0,0,0" Text="500" VerticalContentAlignment="Center"
                                             ToolTip="80 a 10.000 ms; desplaza el bloque siguiente."/>
                                    <TextBlock Text="VEGAS:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ComboBox x:Name="TransitionVegasEffectCombo" Width="155" Height="25" Margin="6,0,0,0" SelectedIndex="0"
                                              SelectionChanged="VegasEffectSelection_Changed"
                                              ToolTip="Solo para Cruce de capas. El MP4 muestra un cruce de opacidad; el efecto exacto se ve en VEGAS.">
                                        <ComboBoxItem Content="Fundido normal"/>
                                        <ComboBoxItem Content="Disolvente aditivo"/>
                                        <ComboBoxItem Content="Flash suave"/>
                                        <ComboBoxItem Content="Barrido izquierda→derecha"/>
                                        <ComboBoxItem Content="Plugin del catálogo…"/>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel x:Name="TransitionTargetsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Aplicar cruce a:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox x:Name="TransitionBackgroundCheck" Content="Fondo" IsChecked="True" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="TransitionCharacterCheck" Content="Personajes" IsChecked="True" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="TransitionImageCheck" Content="Imágenes / GIF" IsChecked="True" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="TransitionVideoCheck" Content="Videos" IsChecked="True"/>
                                </WrapPanel>
                                <!-- Parámetros de Cámara, Cine, Gesto y Desenfoque (1.1.1): lo mismo que las líneas del Director (prompt). -->
                                <WrapPanel x:Name="CameraOptionsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Cámara:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CameraModeCombo" Width="185" Height="25" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="EffectOption_Changed"
                                                  ToolTip="Encuadrar: sigue al personaje elegido. Quien habla: salta a cada personaje que empieza una línea. Punto: zoom sobre el centro movido X/Y. Plano general: vuelve al cuadro completo.">
                                            <ComboBoxItem Content="Encuadrar al personaje"/><ComboBoxItem Content="Seguir a quien habla"/><ComboBoxItem Content="Punto del cuadro"/><ComboBoxItem Content="Plano general"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Zoom ×:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CameraZoomBox" Width="48" Height="25" Margin="5,0,0,0" Text="1.4" VerticalContentAlignment="Center" ToolTip="1 a 3 (1.4 = 140 %). El plano general siempre es 1."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Movimiento ms:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CameraMoveBox" Width="58" Height="25" Margin="5,0,0,0" Text="300" VerticalContentAlignment="Center" ToolTip="0 a 5000 ms; 0 = corte seco."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Enfoque:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CameraFocusCombo" Width="80" Height="25" Margin="5,0,0,0" SelectedIndex="0" ToolTip="Cara: la parte superior del render. Cuerpo: su centro.">
                                            <ComboBoxItem Content="cara"/><ComboBoxItem Content="cuerpo"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Ajuste X:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CameraOffsetXBox" Width="50" Height="25" Margin="5,0,10,0" Text="0" VerticalContentAlignment="Center" ToolTip="±640 px; negativo mueve el centro a la izquierda."/>
                                        <TextBlock Text="Y:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CameraOffsetYBox" Width="50" Height="25" Margin="5,0,0,0" Text="0" VerticalContentAlignment="Center" ToolTip="±360 px; negativo mueve el centro hacia arriba."/>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel x:Name="CinemaOptionsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Barras:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CinemaModeCombo" Width="95" Height="25" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="EffectOption_Changed"
                                                  ToolTip="Las barras siguen en las escenas siguientes del episodio hasta un bloque «Quitar».">
                                            <ComboBoxItem Content="Mostrar"/><ComboBoxItem Content="Quitar"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Estilo:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CinemaStyleCombo" Width="165" Height="25" Margin="6,0,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Cerrado (barras anchas)"/><ComboBoxItem Content="Abierto (barras finas)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Transición ms:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CinemaMoveBox" Width="58" Height="25" Margin="5,0,0,0" Text="800" VerticalContentAlignment="Center" ToolTip="0 a 5000 ms que tardan las barras en entrar o salir; 0 = de golpe."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Capas:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CinemaLayersCombo" Width="170" Height="25" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="EffectOption_Changed"
                                                  ToolTip="Dónde va el Cortador de galletas en VEGAS. Lo que esté delante de una capa con barras también las lleva.">
                                            <ComboBoxItem Content="Todas las capas"/><ComboBoxItem Content="Solo personajes"/><ComboBoxItem Content="Personajes elegidos…"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <ListBox x:Name="CinemaCharactersList" Width="230" Height="84" Margin="0,0,0,4" SelectionMode="Multiple" DisplayMemberPath="Name" Visibility="Collapsed"
                                             ToolTip="Pulsa para marcar o desmarcar. Sin ninguno de ellos en pantalla no hay barras."/>
                                </WrapPanel>
                                <WrapPanel x:Name="GestureOptionsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Gesto:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="GestureModeCombo" Width="200" Height="25" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="EffectOption_Changed"
                                                  ToolTip="Una vez: el personaje elegido. Quien habla: desde aquí, cada personaje que empieza una línea (hasta «Dejar de gesticular»).">
                                            <ComboBoxItem Content="Este personaje, una vez"/><ComboBoxItem Content="Quien habla, desde aquí"/><ComboBoxItem Content="Dejar de gesticular"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Movimientos:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="GestureStepsCombo" Width="150" Height="25" Margin="6,0,0,0" IsEditable="True" Text="balanceo"
                                                  ToolTip="«+» = a la vez, «,» = uno tras otro. Ej.: rebote, balanceo  ·  balanceo+rebote">
                                            <ComboBoxItem Content="balanceo"/><ComboBoxItem Content="rebote"/><ComboBoxItem Content="balanceo+rebote"/>
                                            <ComboBoxItem Content="balanceo, rebote"/><ComboBoxItem Content="rebote, balanceo"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Ángulo °:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GestureAngleBox" Width="44" Height="25" Margin="5,0,0,0" Text="5" VerticalContentAlignment="Center" ToolTip="0.5 a 20 grados de inclinación del balanceo."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Estirar %:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GestureStretchBox" Width="44" Height="25" Margin="5,0,0,0" Text="8" VerticalContentAlignment="Center" ToolTip="-30 a 40 % del rebote; negativo aplasta. Mínimo ±1."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Lado:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="GestureSideCombo" Width="90" Height="25" Margin="5,0,0,0" SelectedIndex="0" ToolTip="Auto: hacia el centro de la escena, alternando.">
                                            <ComboBoxItem Content="auto"/><ComboBoxItem Content="derecha"/><ComboBoxItem Content="izquierda"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Velocidad ×:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GestureSpeedBox" Width="44" Height="25" Margin="5,0,0,0" Text="1" VerticalContentAlignment="Center" ToolTip="0.5 a 3; 2 = el doble de rápido."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Eje:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="GesturePivotCombo" Width="90" Height="25" Margin="5,0,0,0" SelectedIndex="0" ToolTip="Punto fijo del giro y del estiramiento.">
                                            <ComboBoxItem Content="pies"/><ComboBoxItem Content="cintura"/><ComboBoxItem Content="centro"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel x:Name="BlurOptionsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Desenfocar:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="BlurTargetCombo" Width="165" Height="25" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="EffectOption_Changed"
                                                  ToolTip="Dura hasta otro desenfoque del mismo objetivo.">
                                            <ComboBoxItem Content="El personaje elegido"/><ComboBoxItem Content="Fondo"/><ComboBoxItem Content="Todos los personajes"/>
                                            <ComboBoxItem Content="Imágenes / GIF"/><ComboBoxItem Content="Videos"/><ComboBoxItem Content="Todo el cuadro"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Estilo:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="BlurStyleCombo" Width="185" Height="25" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="BlurStyleCombo_SelectionChanged"
                                                  ToolTip="Los ajustes de «Desenfoque gaussiano» de VEGAS; Personalizado usa el valor escrito.">
                                            <ComboBoxItem Content="Suavizar (0,02)"/><ComboBoxItem Content="Desenfoque ligero (0,01)"/><ComboBoxItem Content="Nítido / quitar (0)"/><ComboBoxItem Content="Personalizado"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                        <TextBlock Text="Valor:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="BlurAmountBox" Width="58" Height="25" Margin="5,0,0,0" Text="0.02" VerticalContentAlignment="Center"
                                                 TextChanged="BlurAmountBox_TextChanged" ToolTip="0 a 0.1, el rango horizontal y vertical de VEGAS (se anima igual en los dos)."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Transición ms:" VerticalAlignment="Center"/>
                                        <TextBox x:Name="BlurMoveBox" Width="58" Height="25" Margin="5,0,0,0" Text="0" VerticalContentAlignment="Center" ToolTip="0 a 5000 ms que tarda en llegar al nuevo valor; 0 = de golpe."/>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel x:Name="VideoOptionsPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Video en:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="VideoLayerCombo" Width="155" Height="25" Margin="6,0,12,0" SelectedIndex="1" SelectionChanged="VideoLayerCombo_SelectionChanged">
                                        <ComboBoxItem Content="Fondo fijo"/><ComboBoxItem Content="Orden del guion"/><ComboBoxItem Content="Encima de todo"/>
                                    </ComboBox>
                                    <CheckBox x:Name="VideoGreenScreenCheck" Content="Pantalla verde" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Color #" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VideoKeyColorBox" Width="70" Height="25" Margin="4,0,10,0" Text="00FF00" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Tolerancia" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VideoKeyToleranceBox" Width="50" Height="25" Margin="4,0,0,0" Text="0.30" VerticalContentAlignment="Center"
                                             ToolTip="0.01 a 1.00; subir elimina más tonos verdes"/>
                                </WrapPanel>
                                <WrapPanel x:Name="VisualTransformPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                    <StackPanel x:Name="BackgroundZoomPanel" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed">
                                        <TextBlock Text="Zoom:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="BackgroundZoomCombo" Width="78" Height="25" Margin="5,0,0,0" SelectionChanged="BackgroundZoomCombo_SelectionChanged"
                                                  ToolTip="Fondo más grande que el cuadro: se puede desplazar o animar (paneo) sin mostrar bordes negros y sin cambiar de escala al empezar a moverse. Ajusta Ancho/Alto (100 % = 1280×720).">
                                            <ComboBoxItem Content="100 %" Tag="1"/>
                                            <ComboBoxItem Content="115 %" Tag="1.15"/>
                                            <ComboBoxItem Content="125 %" Tag="1.25"/>
                                            <ComboBoxItem Content="150 %" Tag="1.5"/>
                                            <ComboBoxItem Content="175 %" Tag="1.75"/>
                                            <ComboBoxItem Content="200 %" Tag="2"/>
                                            <ComboBoxItem Content="250 %" Tag="2.5"/>
                                            <ComboBoxItem Content="300 %" Tag="3"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="Ancho máx.:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VisualWidthBox" Width="55" Height="25" Margin="5,0,10,0" Text="960" VerticalContentAlignment="Center" TextChanged="VisualSizeBox_TextChanged" ToolTip="64–1280 px (fondo: hasta 3840 = zoom 300 %). El recurso mantiene su proporción."/>
                                    <TextBlock Text="Alto máx.:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VisualHeightBox" Width="55" Height="25" Margin="5,0,10,0" Text="700" VerticalContentAlignment="Center" TextChanged="VisualSizeBox_TextChanged" ToolTip="64–720 px (fondo: hasta 2160 = zoom 300 %). El recurso mantiene su proporción."/>
                                    <TextBlock Text="Escala %:" VerticalAlignment="Center"/>
