<!-- Tema oscuro de Loquendo AI: rojo y blanco. Generado desde la misma tabla que el otro tema:
     los dos definen exactamente las mismas claves (ThemeManager cambia uno por otro en vivo). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Theme.WindowBackground" Color="#141417"/>  <!-- fondo de las ventanas -->
    <SolidColorBrush x:Key="Theme.Surface" Color="#1D1E22"/>  <!-- paneles, tablas, listas -->
    <SolidColorBrush x:Key="Theme.SurfaceAlt" Color="#24252A"/>  <!-- tarjetas y franjas -->
    <SolidColorBrush x:Key="Theme.Border" Color="#36373D"/>  <!-- bordes -->
    <SolidColorBrush x:Key="Theme.Text" Color="#ECECEF"/>  <!-- texto -->
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#9D9EA6"/>  <!-- texto secundario -->
    <SolidColorBrush x:Key="Theme.Accent" Color="#E53935"/>  <!-- rojo Loquendo -->
    <SolidColorBrush x:Key="Theme.AccentHover" Color="#F0514D"/>
    <SolidColorBrush x:Key="Theme.AccentPressed" Color="#C62828"/>
    <SolidColorBrush x:Key="Theme.AccentText" Color="#FFFFFF"/>  <!-- texto sobre rojo -->
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#3A1F21"/>  <!-- rojo muy suave (hover, marcas) -->
    <SolidColorBrush x:Key="Theme.Input" Color="#26272C"/>  <!-- campos de texto y combos -->
    <SolidColorBrush x:Key="Theme.InputBorder" Color="#3D3E45"/>
    <SolidColorBrush x:Key="Theme.InputHoverBorder" Color="#B8403D"/>
    <SolidColorBrush x:Key="Theme.Selection" Color="#C62828"/>  <!-- fila o elemento seleccionado -->
    <SolidColorBrush x:Key="Theme.SelectionText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.InactiveSelection" Color="#4A2426"/>  <!-- selección sin foco -->
    <SolidColorBrush x:Key="Theme.InactiveSelectionText" Color="#ECECEF"/>
    <SolidColorBrush x:Key="Theme.GridHeader" Color="#B71C1C"/>  <!-- cabecera de tablas -->
    <SolidColorBrush x:Key="Theme.GridHeaderText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.GridHeaderSeparator" Color="#C9403C"/>
    <SolidColorBrush x:Key="Theme.GridLine" Color="#2C2D33"/>
    <SolidColorBrush x:Key="Theme.Row" Color="#1D1E22"/>  <!-- filas: blanco… -->
    <SolidColorBrush x:Key="Theme.RowAlt" Color="#28191B"/>  <!-- …y rojo muy suave, alternadas -->
    <SolidColorBrush x:Key="Theme.RowHover" Color="#3A1F21"/>
    <SolidColorBrush x:Key="Theme.ScrollTrack" Color="#1A1B1F"/>  <!-- barras de desplazamiento -->
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#4A4B53"/>
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#E53935"/>
    <SolidColorBrush x:Key="Theme.SliderTrack" Color="#45474F"/>  <!-- línea de tiempo y deslizadores: parte sin recorrer -->
    <SolidColorBrush x:Key="Theme.SliderThumbRing" Color="#16171A"/>  <!-- aro de la bolita -->
    <SolidColorBrush x:Key="Theme.PlayerBar" Color="#1D1E22"/>  <!-- barra de controles de la preview -->
    <SolidColorBrush x:Key="Theme.Warning" Color="#F2A922"/>  <!-- icono de aviso en los mensajes -->
    <SolidColorBrush x:Key="Theme.Info" Color="#5E6068"/>  <!-- icono de información en los mensajes -->
    <SolidColorBrush x:Key="Theme.TabStrip" Color="#1D1E22"/>  <!-- franja de pestañas -->
    <SolidColorBrush x:Key="Theme.TabText" Color="#D5D5DA"/>
    <SolidColorBrush x:Key="Theme.TabHover" Color="#3A1F21"/>
    <SolidColorBrush x:Key="Theme.HeaderBar" Color="#B71C1C"/>  <!-- cabecera de la ventana -->
    <SolidColorBrush x:Key="Theme.HeaderBarText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.HeaderBarMuted" Color="#FFCDD2"/>
    <SolidColorBrush x:Key="Theme.HeaderBarButton" Color="#26FFFFFF"/>  <!-- botones sobre la cabecera -->
    <SolidColorBrush x:Key="Theme.HeaderBarButtonHover" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="Theme.ToolTip" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="Theme.ToolTipText" Color="#1D1D21"/>
    <SolidColorBrush x:Key="Theme.ButtonBackground" Color="#2A2B31"/>  <!-- botones -->
    <SolidColorBrush x:Key="Theme.ButtonHover" Color="#3A1F21"/>
    <SolidColorBrush x:Key="Theme.ButtonPressed" Color="#4A2426"/>
    <SolidColorBrush x:Key="Theme.ButtonBorder" Color="#43444C"/>
    <SolidColorBrush x:Key="Theme.Splitter" Color="#2A2B31"/>  <!-- divisores arrastrables -->
    <SolidColorBrush x:Key="Theme.StatusBar" Color="#1A1B1F"/>  <!-- barra de estado -->
    <!-- Colores del sistema que usan las plantillas estándar de WPF (selección de celdas, esquinas de scroll…). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1D1E22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#24252A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECECEF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECECEF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9D9EA6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C62828"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#4A2426"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECECEF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1D1E22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#ECECEF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#36373D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#36373D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#1D1D21"/>
</ResourceDictionary>
